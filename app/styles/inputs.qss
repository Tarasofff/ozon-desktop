QLineEdit {
    border: 1px solid #ccc;
    border-radius: 8px;
    padding: 8px;
    font-size: 14px;
}

QLineEdit:focus {
    border: 1px solid #2d7ff9;
}

QLineEdit[error="true"] {
    border: 1px solid #e53935;
    background-color: #130101;
}

QLineEdit[error="true"]:focus {
    border: 1px solid #e53935;
}

QDateEdit {
    border: 1px solid #ccc;
    border-radius: 8px;
    padding: 8px;
    font-size: 14px;
}

QDateEdit:focus {
    border: 1px solid #2d7ff9;
}

QComboBox {
    border: 1px solid #ccc;
    border-radius: 8px;
    padding: 8px;
    font-size: 14px;
}

QComboBox:focus {
    border: 1px solid #2d7ff9;
}