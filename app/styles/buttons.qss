/* Базовая кнопка */
QPushButton {
    border: none;
    border-radius: 8px;
    padding: 10px 14px;
    min-height: 24px;
    font-size: 14px;
}

/* Стандартная кнопка */
QPushButton#baseButton {
    background-color: #2D7FF9;
    color: white;
}

QPushButton#baseButton:hover {
    background-color: #1F6DE0;
}

QPushButton#baseButton:pressed {
    background-color: #1A5FC0;
}